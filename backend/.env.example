# 复制为 .env 后填写。.env 已被 .gitignore 忽略。
#
# 两块 Key 都是**可选增强**：不填也能完整跑起来，
# 只是退化成"本地估算 + 规则生成"，接口返回的 source 字段会如实标注。

# ---- 高德地图（Web 服务 Key）----
# 申请：https://lbs.amap.com  ->  控制台  ->  应用管理  ->  新建应用  ->  添加 Key  ->  服务平台选「Web服务」
AMAP_API_KEY=your_amap_web_service_key
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=10
AMAP_CACHE_TTL_SECONDS=600

# ---- 高德 POI 候选池 ----
# 把"某城市有什么可玩的"攒成本地表，供大模型从中选点。
# 首次生成某城市行程时会宽召回（约 6 次请求），之后走 SQLite，30 天后再刷新。
POI_POOL_ENABLED=1
POI_POOL_TTL_DAYS=30
POI_POOL_MAX_PER_CITY=120

# ---- 大模型（阿里云百炼 · OpenAI 兼容模式）----
# 申请：https://bailian.console.aliyun.com  ->  API-KEY 管理
# 不填则自动走规则生成，功能不受影响。
#
# 【注意键名是 LLM_API_KEY，不要改成 DASHSCOPE_API_KEY】
#   config.py 的 _load_dotenv 用的是 os.environ.setdefault —— 已存在的环境
#   变量优先。若本机恰好已导出一个失效的同名变量，你填在这里的真 Key 会被
#   静默忽略，排查起来非常费时。取一个不冲突的名字可以从根上避开这个坑。
LLM_ENABLED=1
LLM_API_KEY=your_dashscope_api_key
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-27b

# 超时给宽一些：实测生成一份 5 天行程约 17 秒，城市/天数越多越慢。
LLM_TIMEOUT_SECONDS=180

# 思考模式。默认关闭 —— 实测它不影响结构化输出的正确性，
# 却会多产生数千个 reasoning token，把耗时从 17 秒推到 117 秒。
# 想要更强的排期质量时可以置 1，代价是响应明显变慢。
LLM_ENABLE_THINKING=0
